[Unit]
Description=PRISM B3 all-entries SHADOW worker (%i market, no orders)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/prism-insight
Environment=PYTHONUNBUFFERED=1
# pyenv shims are not executable under systemd (203/EXEC); use the versioned interpreter.
ExecStart=/bin/sh -c "exec /root/.pyenv/versions/3.11.11/bin/python3 /root/prism-insight/tools/run_b3_ae_shadow.py --market %i"
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077

[Install]
WantedBy=multi-user.target
