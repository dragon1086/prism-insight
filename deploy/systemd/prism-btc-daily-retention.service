[Unit]
Description=PRISM BTC verified daily review retention
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/prism-insight
Environment=PYTHONPATH=/root/prism-insight:/root/prism-insight/prism-btc
Environment=PRISM_DISABLE_SIGNAL_PUBLISH=1
Environment=PRISM_OBSERVABILITY_SPOOL=/dev/null
ExecStart=/root/.pyenv/versions/3.11.11/bin/python /root/prism-insight/tools/run_btc_review_retention_daily.py
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=600
UMask=0077
