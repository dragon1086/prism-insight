# Internal-only Stance service. Keep it bound to 127.0.0.1 with one worker.
STANCE_INTERNAL_URL=http://127.0.0.1:8800

# Enables the registration form and POST /api/stance/v1/strategies.
STANCE_PUBLIC_REGISTRATION=false

# Shared only by the dashboard server and the internal Stance service.
# Never prefix this with NEXT_PUBLIC_ or expose it to the browser.
STANCE_REGISTRATION_TOKEN=replace-with-a-long-random-secret
